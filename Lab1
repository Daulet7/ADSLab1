void sieve(int n){
    vector<bool> prime(9000, true);
    vector<int> superprime;

    prime[0] = prime[1] = false;

    for(int i = 2; i*i <= 9000; i++){
        if(prime[i] == true){
            for(int j = i*i; j<=9000; j+=i){
                prime[j]=false;
            }
        }
    }

    int index = 0;
    for(int i = 2; i <= 9000; i++){
        if(prime[i]==true){
            index++;
            for(int j = 2; j<=9000; j++){
                if(prime[j]==true && j == index){
                    superprime.push_back(i);
                }
            }
        }
    }

    cout << superprime[n-1];
}

int main() {
    int n;
    cin >> n;

    sieve(n);

    return 0;
}
