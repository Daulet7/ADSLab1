#include <iostream>
#include <queue>
#include <vector>

using namespace std;

vector<int> deck(int k){
    queue<int> q;
    for(int i = 1; i <= k; i++){
        q.push(i);
    }

    int a, c;
    int t = 1;
    vector<int> v(k);

    while (q.size() != 0){
        for(int i = 1; i <=t; i++){
            a = q.front();
            q.push(a);
            q.pop();
        }
        c = q.front();
        v[c-1]=t;
        q.pop();
        t++;
    }

    return v;
}

int main(){
    int k;
    cin >> k;
    while(k!=0){
        int d;
        cin >> d;
        vector<int> ans = deck(d);
        for(int x : ans){
            cout << x << " ";
        }
        cout << endl;
        k--;
    }
    return 0;
}


