#include <iostream> 
#include <stack>
#include <string>

using namespace std;

int check(string a, string b){

    stack<char> aa;
    stack<char> bb;
    bool answer = 1;

    for(int i=0; i<a.size(); i++){
        if(a[i] == '#' && !aa.empty()){
            aa.pop();
        }
        else if (a[i] != '#'){
            aa.push(a[i]);
        }
    }

    for(int i=0; i<b.size(); i++){
        if(b[i] == '#' && !bb.empty()){
            bb.pop();
        }
        else if (b[i] != '#'){
            bb.push(b[i]);
        }
    }

    if(aa.size() != bb.size()){
        answer = 0;
    }

    else{
        while(!aa.empty()){
            if (aa.top() == bb.top()){
                aa.pop();
                bb.pop();
            }
            else{
                answer = 0;
                break;
            }
        }
    }

    if(answer == 1){
        cout << "Yes";
    }
    else{
        cout << "No";
    }

    return 0;
}

int main(){
    string a, b;
    cin >> a >> b;
    check(a,b);
    return 0;
}


