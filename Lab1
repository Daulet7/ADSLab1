using namespace std;

void game(vector<int> B, vector<int> N){
    queue<int> b;
    queue<int> n;

    for(int i = 0; i<B.size(); i++){
        b.push(B[i]);
    }

    for(int i = 0; i<N.size(); i++){
        n.push(N[i]);
    }

    long long moves = 0;

    while(!b.empty() && !n.empty() && moves != 1000000){
        int o = b.front();
        int u = n.front();

        b.pop();
        n.pop();

        if(o == 0 && u == 9){
            b.push(o);
            b.push(u);
        }
        else if (o == 9 && u == 0){
            n.push(o);
            n.push(u);
        }
        else if (o<u){
            n.push(o);
            n.push(u);
        }
        else{
            b.push(o);
            b.push(u);
        }

        moves++;
    }

    if(b.empty() && moves != 1000000){
        cout << "Nursik" << ' ' << moves;
    }
    else if (n.empty() && moves != 1000000){
        cout << "Boris" << ' ' << moves;
    }
    else{
        cout << "blin nichya";
    }
}

int main(){
    vector<int> B(5);
    vector<int> N(5);

    for(int i = 0; i<5; i++){
        cin >> B[i];
    }
    
    for(int i = 0; i<5; i++){
        cin >> N[i];
    }

    game(B,N);

    return 0;

}
